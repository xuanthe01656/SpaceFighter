# Web hosted by Node server: keep blank (same-origin /api/v1).
# Native Capacitor app: MUST set an externally reachable HTTPS API base.
# VITE_GAME_API_URL=https://game.example.com/api/v1

# Build channel: staging-qa | release-candidate | production
VITE_SF_BUILD_CHANNEL=release-candidate
VITE_APP_VERSION=1.2.2
# Internal release-candidate only; production must remain false until rollout approval.
VITE_C15_RC4_CANARY_SETTLEMENT_ENABLED=false
# RC5 Android control/frame-pacing candidate only; production rollout remains separately gated.
VITE_C15_RC5_CONTROL_ENABLED=false
# RC7 Android app-private remote asset delivery. Keep false for web/local legacy preview.
VITE_C15_RC7_ASSET_DELIVERY_ENABLED=false
