{
  "name": "astro-cat-client",
  "version": "1.2.1-graphics21.8-assetsB2.2.0",
  "description": "Astro Cat multiplayer game - React frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check:safety": "node scripts/check-phase1-security.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:config": "node scripts/audit-config.mjs",
    "check:phase0": "npm run check:phase1",
    "check:imports": "node scripts/check-imports.mjs",
    "check:release": "npm run check:graphics21:full && node scripts/audit-assets.mjs --strict && node scripts/audit-config.mjs --strict",
    "check:phase1": "npm run test && npm run check:safety && npm run check:imports && npm run audit:assets && npm run audit:config",
    "check:gameplay": "node scripts/check-phase2-gameplay.mjs",
    "check:phase2": "npm run check:phase1 && npm run check:gameplay && npm run check:catalog",
    "generate:ship-assets": "node scripts/generate-ship-manifest.mjs",
    "check:ship-assets": "node scripts/generate-ship-manifest.mjs --check",
    "check:graphics21": "npm run check:ship-assets && node scripts/check-graphics21.mjs",
    "check:graphics21:full": "npm run check:phase2 && npm run check:graphics21",
    "check:catalog": "node scripts/check-product-catalog.mjs && node scripts/check-background-catalog.mjs && node scripts/background-asset-manifest.mjs --check && npm run check:asset-contracts",
    "check:bundle": "node scripts/check-startup-bundle.mjs",
    "prebuild": "npm run assets:manifest && npm run check:catalog",
    "build:mobile": "npm run build && node scripts/prepare-mobile-bundle.mjs",
    "check:backgrounds": "node scripts/check-background-catalog.mjs && node scripts/background-asset-manifest.mjs --check",
    "backgrounds:manifest": "node scripts/background-asset-manifest.mjs --write",
    "backgrounds:art-qa": "python scripts/background-art-qa.py",
    "assets:manifest": "node scripts/generate-visual-manifest.mjs",
    "check:asset-contracts": "node scripts/generate-visual-manifest.mjs --check && node scripts/check-asset-contracts.mjs && npm run check:enemy-boss-art && npm run check:enemy-boss-models",
    "assets:preview": "node scripts/export-visual-placeholders.mjs",
    "check:enemy-boss-art": "node scripts/check-enemy-boss-contracts.mjs",
    "check:enemy-boss-models": "node scripts/check-enemy-boss-models.mjs",
    "gate:c15-rc1": "node ../tools/run-c15-rc1-gate.mjs",
    "generate:c15-kernel": "node scripts/generate-c15-browser-kernel.mjs",
    "check:c15-kernel": "node scripts/generate-c15-browser-kernel.mjs --check",
    "gate:c15-rc1b": "node ../tools/run-c15-rc1b-gate.mjs",
    "gate:c15-rc1c": "node ../tools/run-c15-rc1c-rc2-gate.mjs",
    "gate:c15-rc3": "node ../tools/run-c15-rc3-gate.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.5.1",
    "@babylonjs/gui": "^9.5.1",
    "@babylonjs/loaders": "^9.5.1",
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/ios": "8.5.3",
    "@capawesome/capacitor-app-update": "8.1.1",
    "@capgo/capacitor-social-login": "8.7.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@revenuecat/purchases-capacitor": "13.7.5",
    "crypto-js": "^4.2.0",
    "firebase": "^12.9.0",
    "framer-motion": "^12.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "socket.io-client": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-react": "^3.0.0",
    "javascript-obfuscator": "^5.3.0",
    "terser": "^5.46.0",
    "vite": "^4.0.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
